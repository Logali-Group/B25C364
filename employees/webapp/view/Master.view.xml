<mvc:View 
            controllerName="com.logaligroup.employees.controller.Master"
            xmlns="sap.m"
            xmlns:f="sap.f"
            xmlns:core="sap.ui.core" 
            xmlns:mvc="sap.ui.core.mvc"
            xmlns:fb="sap.ui.comp.filterbar">

        <f:DynamicPage>
        
            <f:title>
                <f:DynamicPageTitle>

                    <f:heading>

                        <Title text="{i18n>appTitle}"
                                    wrapping="true"/>
                    </f:heading>
                
                </f:DynamicPageTitle>
            </f:title>

            <f:header>
            
                <f:DynamicPageHeader>

                    <fb:FilterBar id="filterbar"
                                    search="onSearchPress"
                                    showClearOnFB="true"
                                    clear="onClearPress">
                    
                        <fb:filterGroupItems>

                            <fb:FilterGroupItem
                                            groupName="filters"
                                            name="employee"
                                            label="{i18n>employee}"
                                            visibleInFilterBar="true">
                                <fb:control>

                                    <Input />
                                
                                </fb:control>
                            
                            </fb:FilterGroupItem>

                            <fb:FilterGroupItem groupName="filters"
                                                name="country"
                                                label="{i18n>country}"
                                                visibleInFilterBar="true">
                                <fb:control>

                                    <ComboBox
                                                items="{countries>/Countries}">
                                        <core:Item key="{countries>key}" text="{countries>country}"/>
                                    </ComboBox>
                                
                                </fb:control>
                            
                            </fb:FilterGroupItem>
                        
                        </fb:filterGroupItems>
                    
                    </fb:FilterBar>
                    
                
                </f:DynamicPageHeader>
            
            </f:header>


            <f:content>

                <Table id="table"
                        items="{employees>/Employees}">


                    <headerToolbar>

                        <Toolbar>

                            <ToolbarSpacer/>
                            <Button
                                    text="{i18n>download}"
                                    tooltip="{i18n>download}"
                                    press="onDownloadPress"
                                    type="Emphasized"
                                    width="6rem"/>
                        
                        </Toolbar>
                    
                    </headerToolbar>
                

                    <columns>

                        <Column>
                            <Label text="{i18n>ID}"/>
                        </Column>
                    
                        <Column>
                            <Label text="{i18n>country}"/>
                        </Column>
                    
                        <Column>
                            <Label text="{i18n>city}"/>
                        </Column>
                    
                        <Column>
                            <Label text="{i18n>postalCode}"/>
                        </Column>
                    
                    </columns>

                    <items>

                        <ColumnListItem
                                        type="Navigation"
                                        press="onNavToDetails">

                            <cells>

                                <ObjectIdentifier title="{employees>EmployeeID}" text="{employees>FirstName} {employees>LastName}"/>
                                <Text text="{employees>Country}"/>
                                <Text text="{employees>City}"/>
                                <Text text="{employees>PostalCode}"/>
                            
                            </cells>
                        
                        </ColumnListItem>
                    
                    </items>
                
                </Table>
            
            </f:content>
        
        </f:DynamicPage>

</mvc:View>