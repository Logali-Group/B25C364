<core:FragmentDefinition 
                        xmlns="sap.m" 
                        xmlns:core="sap.ui.core">

	<SelectDialog
		id="selectDialog"
		title="{i18n>countries}"
		items="{countries>/Countries}"
		search=".onValueHelpSearch"
		confirm=".onCountryValueHelpConfirm"
		cancel=".onCountryValueHelpCancel"
		multiSelect="true">

		<StandardListItem
			icon="{countries>flag}"
			iconDensityAware="false"
			iconInset="false"
			title="{countries>country}"
			description="{countries>key}"/>

	</SelectDialog>

</core:FragmentDefinition>