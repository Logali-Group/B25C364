<mvc:View
                controllerName="com.logaligroup.invoices.controller.Main"
                xmlns="sap.m"
                xmlns:mvc="sap.ui.core.mvc">

    <Page
            title="{i18n>appTitle}">

        <customHeader>
                <Toolbar>
                        <content>
                                <Title text="{i18n>appTitle}"/>
                        </content>
                </Toolbar>
        </customHeader>
        
        <content>

                <Panel  headerText="{i18n>helloPanel}">
                        <content>
                                <Button
                                        text="{i18n>showHelloButtonText}"
                                        press="onShowMessage"/> 
                        </content>
                </Panel>

        </content>

    </Page>

</mvc:View>