<mvc:View
                controllerName="com.logaligroup.invoices.controller.Main"
                xmlns="sap.m"
                xmlns:mvc="sap.ui.core.mvc">

    <Page
            title="{i18n>appTitle}">

        <customHeader>
                <Toolbar>
                        <content>
                                <Title text="{i18n>appTitle}"/>
                                <ToolbarSpacer/>
                                <Button
                                        text="{i18n>helloDialogBut}"
                                        press="onOpenDialog"
                                        width="7rem"/>
                        </content>
                </Toolbar>
        </customHeader>
        
        <content>
                <mvc:XMLView id="helloPanel"
                        viewName="com.logaligroup.invoices.view.HelloPanel"
                        type="XML"/>
        </content>

    </Page>

</mvc:View>