<mvc:View
        controllerName="com.logaligroup.invoices.controller.InvoicesList"
        xmlns="sap.m"
        xmlns:mvc="sap.ui.core.mvc"
        xmlns:core="sap.ui.core">


        <List   id="list"
                headerText="{i18n>invoicesListTitle}"
                growing="true"
                growingScrollToLoad="true"
                growingThreshold="50"
                class="sapUiResponsiveMargin"
                items="{
                    path: 'northwind>/Invoices',
                    filters: [
                        {
                            path: 'ExtendedPrice',
                            operator: 'BT',
                            value1: '0.00',
                            value2: '50.00'
                        }
                    ], 
                    sorter: {
                        path: 'ShipperName',
                        group: true
                    }
                }"
                width="auto">

            <headerToolbar>
                <Toolbar>
                    <Title text="{i18n>invoicesListTitle}"/>
                    <ToolbarSpacer/>
                    <SearchField id="searchField" search="onFilterPress" 
                                width="50%"/>
                </Toolbar>
            </headerToolbar>

            <items>

                <ObjectListItem 
                        type="Navigation"
                        press="onNavToDetail"
                        intro="{northwind>Quantity}"
                        title="{northwind>ProductName}"
                        number="{
                            parts: [
                                'northwind>ExtendedPrice',
                                'currency>/usd'
                            ],
                            type: 'sap.ui.model.type.Currency',
                            formatOptions: {
                                showMeasure: false
                            }
                        }"
                        numberUnit="{
                            path: 'currency>/usd',
                            type: 'sap.ui.model.type.String'
                        }"
                        numberState="{=
                            (${northwind>ExtendedPrice} >= 10.00 &amp;&amp; ${northwind>ExtendedPrice} &lt;= 19.99)? 'Warning' :
                            (${northwind>ExtendedPrice} >= 00.00 &amp;&amp; ${northwind>ExtendedPrice} &lt;= 9.99)? 'Information' : 
                            (${northwind>ExtendedPrice} >= 20.00 &amp;&amp; ${northwind>ExtendedPrice} &lt;= 39.99)? 'Success' : 'Error'
                        }">

                    <!-- <firstStatus>
                        <ObjectStatus 
                            core:require="{
                                MyFormatter: 'com/logaligroup/invoices/model/formatter'
                            }"
                            text="{
                                path: 'northwind>Status',
                                formatter: 'MyFormatter.statusText.bind($controller)'
                            }"/>
                    </firstStatus> -->

                </ObjectListItem>
            
            </items>


        </List>

</mvc:View>