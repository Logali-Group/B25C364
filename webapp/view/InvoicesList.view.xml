<mvc:View
        controllerName="com.logaligroup.invoices.controller.InvoicesList"
        xmlns="sap.m"
        xmlns:mvc="sap.ui.core.mvc"
        xmlns:core="sap.ui.core">


        <List   id="list"
                headerText="{i18n>invoicesListTitle}"
                class="sapUiResponsiveMargin"
                items="{invoices>/Invoices}"
                width="auto">

            <items>

                <ObjectListItem 
                        intro="{invoices>Quantity}"
                        title="{invoices>ProductName}"
                        number="{
                            parts: [
                                'invoices>ExtendedPrice',
                                'currency>/usd'
                            ],
                            type: 'sap.ui.model.type.Currency',
                            formatOptions: {
                                showMeasure: false
                            }
                        }"
                        numberUnit="{
                            path: 'currency>/usd',
                            type: 'sap.ui.model.type.String'
                        }"
                        numberState="{=
                            (${invoices>ExtendedPrice} >= 10.00 &amp;&amp; ${invoices>ExtendedPrice} &lt;= 19.99)? 'Warning' :
                            (${invoices>ExtendedPrice} >= 00.00 &amp;&amp; ${invoices>ExtendedPrice} &lt;= 9.99)? 'Information' : 
                            (${invoices>ExtendedPrice} >= 20.00 &amp;&amp; ${invoices>ExtendedPrice} &lt;= 39.99)? 'Success' : 'Error'
                        }">

                    <firstStatus>
                        <ObjectStatus 
                            core:require="{
                                MyFormatter: 'com/logaligroup/invoices/model/formatter'
                            }"
                            text="{
                                path: 'invoices>Status',
                                formatter: 'MyFormatter.statusText.bind($controller)'
                            }"/>
                    </firstStatus>

                </ObjectListItem>
            
            </items>


        </List>

</mvc:View>