<core:FragmentDefinition
                xmlns="sap.m"
                xmlns:core="sap.ui.core"
                xmlns:form="sap.ui.layout.form">

    <Panel headerText="{i18n>panelFrTitle}"
            class="sapUiResponsiveMargin"
            width="auto">
            
        <content>
            <form:SimpleForm
                            editable="true">
                <form:content>
                    <Label text="{i18n>labelName}"/>
                    <Input width="40%"/>
                    <Label text="{i18n>labelSurname}"/>
                    <Input width="40%"/>
                </form:content>
            </form:SimpleForm>
        </content>

    </Panel>


</core:FragmentDefinition>